# ============================================================================
# NEUROCRAFT CONFIGURATION (.env.example)
# Copy to .env and paste your Gemini API key after GEMINI_API_KEY=
# ============================================================================

GEMINI_API_KEY=PASTE_YOUR_GEMINI_API_KEY_HERE
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.8-flash

# Bot Settings
BOT_USERNAME=NeuroAgent

# Leave MC_PORT=0 to auto-discover your Singleplayer "Open to LAN" world
MC_HOST=127.0.0.1
MC_PORT=0
# Optional: Leave MC_VERSION blank to auto-detect (Supports 1.8.8 up to 1.21.4; 1.20.4 or 1.21.1/1.21.4 recommended)
MC_VERSION=
